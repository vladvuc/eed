{
  "name": "gdp-statistika",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "build:map": "tsx scripts/build-europe-map.ts",
    "start": "NODE_ENV=production node server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "concurrently": "^9.0.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.59.0",
    "oxlint": "^1.88.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.29.1"
